#!/usr/bin/env python3
"""Generate the configured journey frame sequence from local source photos."""

from pathlib import Path
import re
import shutil
import subprocess
import sys

from PIL import Image

ROOT = Path(__file__).resolve().parents[1]
CONFIG = (ROOT / "src/config/frames.ts").read_text()


def config_value(name: str) -> int | str:
    match = re.search(rf"export const {name} = (\d+|\"[^\"]+\")", CONFIG)
    if not match:
        raise RuntimeError(f"Missing {name} in src/config/frames.ts")
    value = match.group(1)
    return int(value) if value.isdigit() else value.strip('"')


SCENES = config_value("SCENE_COUNT")
FRAMES = config_value("FRAMES_PER_SCENE")
WIDTH = config_value("FRAME_WIDTH")
HEIGHT = config_value("FRAME_HEIGHT")
EXTENSION = config_value("FRAME_EXTENSION")
SOURCE_DIR = ROOT / "stitch/crest-export-website/7b360f04e7c449b082622925db2e1a86"
SOURCE_NAMES = [f"journey-source-{index:02d}.jpg" for index in range(1, 5)]
MOTIONS = [
    ("in", "center"),
    ("out", "left"),
    ("in", "left"),
    ("out", "right"),
    ("in", "right"),
    ("out", "diagonal"),
    ("in", "diagonal"),
]


def expression(direction: str, pan: str) -> tuple[str, str, str]:
    amount = "0.075"
    if direction == "in":
        zoom = f"1+{amount}*pow(on/{FRAMES - 1},2)"
    else:
        zoom = f"1+{amount}*pow(1-on/{FRAMES - 1},2)"
    x = f"(iw-iw/zoom)*on/{FRAMES - 1}"
    y = f"(ih-ih/zoom)*on/{FRAMES - 1}"
    if pan == "left":
        x = f"(iw-iw/zoom)*(1-on/{FRAMES - 1})"
    elif pan == "right":
        x = f"(iw-iw/zoom)*on/{FRAMES - 1}"
    elif pan == "center":
        x = "(iw-iw/zoom)/2"
        y = "(ih-ih/zoom)/2"
    elif pan == "diagonal":
        x = f"(iw-iw/zoom)*on/{FRAMES - 1}"
        y = f"(ih-ih/zoom)*(1-on/{FRAMES - 1})"
    return zoom, x, y


def main() -> None:
    ffmpeg = shutil.which("ffmpeg")
    if not ffmpeg:
        sys.exit("ffmpeg is required. Install ffmpeg, then rerun npm run frames:generate.")
    sources = [SOURCE_DIR / name for name in SOURCE_NAMES]
    missing = [str(path) for path in sources if not path.exists()]
    if missing:
        sys.exit("Missing journey source images:\n" + "\n".join(missing))

    frames_root = ROOT / "public/frames"
    for scene in range(1, SCENES + 1):
        output_dir = frames_root / f"scene-{scene}"
        output_dir.mkdir(parents=True, exist_ok=True)
        for old_frame in output_dir.iterdir():
            if old_frame.is_file():
                old_frame.unlink()

        source = sources[(scene - 1) % len(sources)]
        direction, pan = MOTIONS[(scene - 1) % len(MOTIONS)]
        zoom, x, y = expression(direction, pan)
        target = output_dir / "%03d.png"
        zoompan = (
            f"scale={WIDTH}:{HEIGHT}:force_original_aspect_ratio=increase,"
            f"crop={WIDTH}:{HEIGHT},zoompan=z='{zoom}':x='{x}':y='{y}':"
            f"d={FRAMES}:s={WIDTH}x{HEIGHT}:fps=24"
        )
        subprocess.run(
            [ffmpeg, "-hide_banner", "-loglevel", "error", "-y", "-i", str(source),
             "-vf", zoompan, "-frames:v", str(FRAMES), str(target)],
            check=True,
        )
        for png in output_dir.glob("*.png"):
            with Image.open(png) as image:
                image.save(png.with_suffix(f".{EXTENSION}"), format=EXTENSION.upper(), quality=75, method=4)
            png.unlink()
        print(f"Scene {scene}: {FRAMES} frames from {source.name}")


if __name__ == "__main__":
    main()
